# Keep GitHub limited to Java source, license, and player documentation.
/*
!/.gitignore
!/LICENSE
!/.readthedocs.yaml
!/mkdocs.yml
!/src/
!/docs/

/src/*
!/src/legacy/
!/src/main/

/src/legacy/*
!/src/legacy/java/
/src/main/*
!/src/main/java/

/src/legacy/java/**
!/src/legacy/java/**/
!/src/legacy/java/**/*.java
/src/main/java/**
!/src/main/java/**/
!/src/main/java/**/*.java

/docs/**
!/docs/**/
!/docs/**/*.md
!/docs/**/*.svg
!/docs/**/requirements.txt
